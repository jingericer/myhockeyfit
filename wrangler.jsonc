{
  "name": "myhockeyfit",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ratelimits": [{ "name": "PHOTO_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
