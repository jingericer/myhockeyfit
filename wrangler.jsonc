{
  "name": "myhockeyfit",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "PHOTO_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PHOTO_HOURLY",
        "class_name": "PhotoHourlyLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "photo-hourly-v1",
      "new_sqlite_classes": [
        "PhotoHourlyLimiter"
      ]
    }
  ]
}
